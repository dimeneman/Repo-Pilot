# ── Frontend Environment Variables ──────────────────────────────────────────

# Backend API base URL
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Production on Vercel:
# Points to your Render backend web service.
# (Note: RepoPilot automatically appends /api/v1 if omitted, but including it is recommended)
# NEXT_PUBLIC_API_URL=https://repo-pilot-backend-i3wm.onrender.com/api/v1
