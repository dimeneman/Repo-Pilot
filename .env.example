# =============================================================================
# RepoPilot Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ── LLM Provider (Google Gemini) ─────────────────────────────────────────────
# Supported: "gemini"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# ── Gemini API Key ───────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://repopilot:repopilot@localhost:5432/repopilot
DATABASE_URL_SYNC=postgresql://repopilot:repopilot@localhost:5432/repopilot

# ── Qdrant Vector Database ──────────────────────────────────────────────────
# Local development:
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Production / Qdrant Cloud (optional, leave empty/unset for local development):
# QDRANT_HOST=https://your-cluster-id.region.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Storage Paths ────────────────────────────────────────────────────────────
REPOS_DIR=./data/repos
UPLOADS_DIR=./data/uploads

# ── Authentication ───────────────────────────────────────────────────────────
# Generate a strong key: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── GitHub OAuth (enables "Continue with GitHub (OAuth)") ────────────────────
# Create an OAuth App at: https://github.com/settings/developers -> "New OAuth App"
# - Application name: RepoPilot
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:3000/auth/callback
# Then copy the generated Client ID and Client Secret:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Ingestion Settings ──────────────────────────────────────────────────────
MAX_FILE_SIZE_KB=500
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# ── Ingestion Runner & GitHub Actions (Zero-Cost Production Runner) ──────────
# INGESTION_RUNNER:
#   "auto" (default): uses GitHub Actions if GITHUB_ACTIONS_TOKEN is set, else falls back to local execution
#   "github_actions": requires GitHub Actions dispatch for all ingestions
#   "direct": runs directly as an in-process async background task (simplest for local dev)
#   "local": enqueues to the local worker daemon / queue
INGESTION_RUNNER=auto
# GitHub Personal Access Token (classic with `repo` scope, or fine-grained with `contents:write`):
GITHUB_ACTIONS_TOKEN=
# Target RepoPilot GitHub repository to dispatch actions to:
GITHUB_REPO_OWNER=dimeneman
GITHUB_REPO_NAME=Repo-Pilot
GITHUB_WORKFLOW_EVENT_TYPE=ingest_repo

# ── Background Worker & Local Queue ──────────────────────────────────────────
# In local Docker Compose or local server without GitHub Actions:
# Set RUN_EMBEDDED_WORKER=true for single-process local dev without running a separate daemon.
RUN_EMBEDDED_WORKER=false
WORKER_POLL_INTERVAL=2.0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3000,https://repo-pilot-steel.vercel.app

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Debug Mode ───────────────────────────────────────────────────────────────
DEBUG=true
